# mount point  fstype  device                                                  [device2]  [flags]
/boot          emmc    /dev/block/platform/mtk-msdc.0/by-name/boot
/recovery      emmc    /dev/block/platform/mtk-msdc.0/by-name/recovery          flags=backup=1
/system        ext4    /dev/block/platform/mtk-msdc.0/by-name/system
/data          ext4    /dev/block/platform/mtk-msdc.0/by-name/userdata          flags=encryptable=/dev/block/platform/mtk-msdc.0/by-name/encrypt
/cache         ext4    /dev/block/platform/mtk-msdc.0/by-name/cache

# MediaTek / LG calibration and IMEI data
/nvram         emmc    /dev/block/platform/mtk-msdc.0/by-name/nvram             flags=display="NVRAM";backup=1
/nvdata        ext4    /dev/block/platform/mtk-msdc.0/by-name/nvdata            flags=display="NVDATA";backup=1
/protect_f     ext4    /dev/block/platform/mtk-msdc.0/by-name/protect1          flags=display="Protect_F";backup=1
/protect_s     ext4    /dev/block/platform/mtk-msdc.0/by-name/protect2          flags=display="Protect_S";backup=1
/proinfo       emmc    /dev/block/platform/mtk-msdc.0/by-name/proinfo           flags=display="Proinfo";backup=1
/persist       ext4    /dev/block/platform/mtk-msdc.0/by-name/persist           flags=display="Persist";backup=1
/persist-lg    ext4    /dev/block/platform/mtk-msdc.0/by-name/persist_lg        flags=display="Persist LG";backup=1
/lk            emmc    /dev/block/platform/mtk-msdc.0/by-name/lk                flags=display="LK";backup=1
/logo          emmc    /dev/block/platform/mtk-msdc.0/by-name/logo              flags=display="Logo";flashimg=1

# Removable storage
/external_sd   vfat    /dev/block/mmcblk1p1  /dev/block/mmcblk1                  flags=display="Micro SD";storage;wipeingui;removable
/usb-otg       vfat    /dev/block/sda1       /dev/block/sda                      flags=display="USB OTG";storage;wipeingui;removable
